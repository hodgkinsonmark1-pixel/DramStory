# Supabase (4 Sep 2026). Both values are PUBLIC - the publishable key is
# designed to ship in client-side code, and Row Level Security is what
# actually protects the data. Copy this file to .env.local for local
# development, and set the same two variables in Vercel.
#
# NEVER put the service role key or the database password in here, in
# Vercel's client-side vars, or anywhere the browser can reach. The
# service role key bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
